{
  "name": "auron",
  "private": true,
  "version": "0.1.0",
  "description": "AURON — RWA + DeFi + stablecoin credit infrastructure POC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run build -w @auron/config && npm run build -w @auron/sdk",
    "predev": "npm run setup",
    "dev": "npm run dev -w @auron/web",
    "build": "npm run build -w @auron/web",
    "lint": "npm run lint -w @auron/config && npm run lint -w @auron/sdk && npm run lint -w @auron/web",
    "test": "npm run test -w @auron/contracts --if-present",
    "contracts:build": "npm run build -w @auron/contracts",
    "contracts:test": "npm run test -w @auron/contracts",
    "chain": "anvil --chain-id 31337",
    "deploy:local": "node scripts/deploy-local.mjs",
    "start": "npm run start -w @auron/web"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
